# Copy to .env.production and fill in. Never commit the real file.
# Run compose with: docker compose --env-file .env.production -f docker-compose.prod.yml ...

# Public hostname only, no scheme. Caddy obtains and renews HTTPS certificates.
DOMAIN=partyplay.example.com
APP_ORIGIN=https://partyplay.example.com

# Database password. If it contains URL-reserved characters, URL-encode it in the
# DATABASE_URL that compose builds (for example @ becomes %40).
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Signs admin sessions. At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Owner account used only by the create-admin command. Change the password before use.
ADMIN_EMAIL=owner@partyplay.co.ke
ADMIN_PASSWORD=ChangeMe-2024
ADMIN_SESSION_HOURS=12

# Hold sweep frequency inside the default compose stack.
HOLD_SWEEP_INTERVAL_MINUTES=5

# Graceful shutdown deadline before the API is forced down.
SHUTDOWN_TIMEOUT_MS=10000
LOG_REQUESTS=true

# Cloudinary image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=partyplay

# Password-reset email. Leave blank to disable email delivery (the CLI fallback remains).
RESEND_API_KEY=
MAIL_FROM="PartyPlay <no-reply@your-verified-domain.example>"

# Backup loop: one dump per day, keep two weeks.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
