# Copy to server/.env and fill in. Never commit the real file.

DATABASE_URL=postgresql://partyplay:partyplay@localhost:5433/partyplay
PORT=4000
CLIENT_URL=http://localhost:5173

# Signs the admin session cookie. At least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# How long an admin session lasts, in hours. Defaults to 12 when unset.
ADMIN_SESSION_HOURS=12

# Used once by `npm run admin:create` to create the first owner account.
# ADMIN_PASSWORD must be at least 10 characters.
ADMIN_EMAIL=owner@partyplay.co.ke
ADMIN_PASSWORD=replace-with-at-least-10-characters
