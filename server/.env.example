# Copy to server/.env and fill in. Never commit the real file.

DATABASE_URL=postgresql://partyplay:partyplay@localhost:5433/partyplay
PORT=4000
CLIENT_URL=http://localhost:5173

# Signs the admin session cookie. At least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# How long an admin session lasts, in hours. Defaults to 12 when unset.
ADMIN_SESSION_HOURS=12

# How often the hold sweeper runs, in minutes. Defaults to 5 when unset.
HOLD_SWEEP_INTERVAL_MINUTES=5

# Number of reverse-proxy hops to trust, so rate limits key on the real client IP.
# Set to 1 behind Caddy; leave unset (or 0) when the API is reached directly.
TRUST_PROXY_HOPS=0

# Transactional email for password reset links. Create a key at https://resend.com/api-keys
# MAIL_FROM must use a sender or domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=PartyPlay <no-reply@your-verified-domain.example>

# Frontend base URL used in one-time password-reset links. Defaults to CLIENT_URL.
APP_BASE_URL=http://localhost:5173

# Used once by `npm run admin:create` to create the first owner account.
# ADMIN_PASSWORD must be at least 8 characters with uppercase, lowercase and a number.
ADMIN_EMAIL=owner@partyplay.co.ke
ADMIN_PASSWORD=ChangeMe-2024
